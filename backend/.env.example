APP_NAME=ScriptSense Backend
APP_VERSION=0.3.0
ENVIRONMENT=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scriptsense
SECRET_KEY=replace-this-with-a-strong-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=10

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

UPLOAD_DIR=uploads
ARTIFACT_DIR=artifacts
MAX_UPLOAD_FILE_SIZE=26214400

LOG_LEVEL=INFO
PLAGIARISM_THRESHOLD=0.72
MAX_PLAGIARISM_MATCHES=5
DEFAULT_REVIEW_PRIORITY=55
PIPELINE_NAME=gradeops-hitl-v1

CORS_ORIGINS=*
